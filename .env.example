# Arcora Environment Configuration
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Application environment (development, testing, production)
ARCORA_ENV=development
ARCORA_LOG_LEVEL=INFO

# Data directory paths (relative to project root or absolute paths)
ARCORA_RAW_DATA_DIR=data/raw
ARCORA_PROCESSED_DATA_DIR=data/processed
ARCORA_REPORTS_DIR=reports
ARCORA_LOGS_DIR=logs

# Dataset source configuration (Nathan Lauga NBA Games Dataset on Kaggle)
KAGGLE_DATASET_SLUG=nathanlauga/nba-games
KAGGLE_DATASET_URL=https://www.kaggle.com/datasets/nathanlauga/nba-games
KAGGLE_DOWNLOAD_API_URL=https://www.kaggle.com/api/v1/datasets/download/nathanlauga/nba-games

# Optional Kaggle API credentials (only required for authenticated Kaggle endpoints)
KAGGLE_USERNAME=
KAGGLE_KEY=
